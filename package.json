{
  "name": "arora-esports-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ARORA ESPORTS - Full-Stack Free Fire Tournament Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "provision:admin": "npm --prefix backend run provision:admin",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  }
}
