# ARORA ESPORTS Backend Environment Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Neon or local PostgreSQL)
# Example Neon URL: postgresql://username:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/arora_esports?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arora_esports

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_change_in_production
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email Provider — Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=ARORA ESPORTS <onboarding@resend.dev>

# Nodemailer with Gmail SMTP (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM="ARORA ESPORTS <your_gmail_address@gmail.com>"
