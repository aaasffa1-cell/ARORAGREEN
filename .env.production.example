# ========================================================
# ARORA ESPORTS - Vercel Production Environment Variables
# Copy & paste these keys into your Vercel Project Settings
# (Project Settings > Environment Variables)
# ========================================================

# Application Environment
NODE_ENV=production

# Cloud PostgreSQL Database URL (Neon / Supabase / AWS RDS / Vercel Postgres)
# Example Neon: postgresql://neondb_owner:npg_xyz@ep-cool-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_neon_host.neon.tech/your_db?sslmode=require

# JWT Secret for Session & Tokens (Generate a secure random string)
JWT_SECRET=generate_a_long_random_jwt_secret_key_minimum_32_chars

# Cookie Domain (Leave blank or set to your custom domain without https/www)
# COOKIE_DOMAIN=

# SMTP Email Configuration (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password
EMAIL_FROM="ARORA ESPORTS <your_email@gmail.com>"
